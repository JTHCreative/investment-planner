# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region your Cloud Functions are deployed to (must match functions/src/index.ts).
VITE_FUNCTIONS_REGION=us-central1
# Set to "true" to talk to the local Firebase emulators instead of the real project.
VITE_USE_EMULATORS=false
