# Copy to .env.local for local development. Everything here is optional.

# Market data keys (free). If unset, each user enters their own in the app's Settings page.
# https://finnhub.io/register  ·  https://www.alphavantage.co/support/#api-key
# VITE_FINNHUB_API_KEY=
# VITE_ALPHA_VANTAGE_API_KEY=

# "mock" uses made-up prices: no keys or internet needed. Handy for trying things out.
# VITE_MARKET_PROVIDER=mock

# Use the local Firebase emulators instead of the real project (npm run emulators).
# VITE_USE_EMULATORS=true

# The web config for the investment-planner-40f1d project is built into src/firebase.ts.
# Set these only to point the app at a different Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
