rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Each user's simulated portfolios, trades and plan history are private to them.
    match /users/{uid}/portfolios/{portfolioId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.cash is number
        && request.resource.data.cash >= 0
        && request.resource.data.startingCash is number
        && request.resource.data.holdings is map
        && request.resource.data.targets is list
        && request.resource.data.targets.size() <= 50;

      // Transactions and allocation revisions.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Market data cache. Only Cloud Functions (admin SDK) write here.
    match /marketQuotes/{symbol} {
      allow read: if signedIn();
    }
    match /marketHistory/{symbol} {
      allow read: if signedIn();
    }
  }
}
