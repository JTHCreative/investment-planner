rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Each user's simulated portfolios, trades and plan history are private to them.
    match /users/{uid}/portfolios/{portfolioId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.cash is number
        && request.resource.data.cash >= 0
        && request.resource.data.startingCash is number
        && request.resource.data.holdings is map
        && request.resource.data.targets is list
        && request.resource.data.targets.size() <= 50;

      // Transactions and allocation revisions.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // The user's own settings (market data API keys).
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Shared price-history cache, filled by the app in each user's browser so a symbol is downloaded once for everyone.
    // Writes must look like a price series; there is no server to vouch for the numbers themselves.
    match /marketHistory/{symbol} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['symbol', 'dates', 'closes', 'fetchedAt'])
        && request.resource.data.symbol == symbol
        && request.resource.data.dates is list
        && request.resource.data.closes is list
        && request.resource.data.dates.size() == request.resource.data.closes.size()
        && request.resource.data.dates.size() > 0
        && request.resource.data.dates.size() <= 12000
        && request.resource.data.fetchedAt is number
        && request.resource.data.fetchedAt <= request.time.toMillis() + 60000;
    }
  }
}
